<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- This is the title that changes per page -->
    <title><%= title %></title>
    
    <!-- Bootstrap CSS (Mandatory) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <!-- Font Awesome (Mandatory) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Your Custom CSS Files -->
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/mobile.css" media="screen and (max-width: 600px)">
    <link rel="stylesheet" href="/stylesheets/tablet.css" media="screen and (min-width: 601px) and (max-width: 900px)">
    <link rel="stylesheet" href="/stylesheets/laptop.css" media="screen and (min-width: 901px)">
</head>
<body>
    <header class="text-center">
        <h1><%= title %></h1>
        <nav>
            <!-- These links point to our Express routes -->
            <a href="/">Home</a>
            <a href="/about">About Me</a>
            <a href="/projects">Projects</a>
            <a href="/contact">Contact Me</a>
        </nav>
    </header>

    <!-- We open a main container here so all our pages look neat -->
    <main class="container my-5">